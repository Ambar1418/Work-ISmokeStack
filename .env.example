# MySQL connection string (TiDB Cloud, PlanetScale, AWS RDS, Railway, or local MySQL)
# Leave unset locally to use automatic local persistence (.data/portfolio-store.json)
DATABASE_URL=mysql://user:password@localhost:3306/sonia_portfolio

# Admin passphrase required to access /admin and all /api/analytics + /api/admin endpoints
# Generate with: openssl rand -hex 32
ADMIN_ANALYTICS_SECRET=replace-with-strong-random-secret

# Groq API Key (server-side ONLY — never prefix with NEXT_PUBLIC_)
GROQ_API_KEY=

# Optional Groq model override (defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
